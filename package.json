{
  "name": "node-scripts",
  "version": "0.1.0",
  "private": true,
  "description": "Scripts that fetch data and turn it into Excel reports, or read reports and write the results back.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js --watch",
    "check": "npm run format:check && npm run lint && npm run test",
    "example:report": "node scripts/example-report.js",
    "check:vault": "node scripts/check-vault.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "transform": {},
    "clearMocks": true
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "got": "^16.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10"
  }
}
